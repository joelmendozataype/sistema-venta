<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="false">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Selenium">
            <directory>tests/Selenium</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">Config</directory>
            <directory suffix=".php">Controllers</directory>
            <directory suffix=".php">Models</directory>
        </include>
        <exclude>
            <file>Config/Config.example.php</file>
        </exclude>
    </source>

    <php>
        <env name="APP_BASE_URL" value="http://localhost/venta/"/>
        <env name="SELENIUM_HUB_URL" value="http://localhost:4444"/>
        <env name="SELENIUM_HEADLESS" value="true"/>
    </php>
</phpunit>

